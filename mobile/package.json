{
	"name": "@protonn-cord/mobile",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun node_modules/@revenge-mod/plugin-cli/bin/revenge-plugin.js build",
		"build:dev": "bun node_modules/@revenge-mod/plugin-cli/bin/revenge-plugin.js build --dev",
		"test": "tsx --test tests/*.test.ts",
		"generate-index": "bun node_modules/@revenge-mod/plugin-cli/bin/revenge-plugin.js generate-index",
		"serve": "bun node_modules/@revenge-mod/plugin-cli/bin/revenge-plugin.js serve --base-url http://127.0.0.1:8080",
		"lint": "biome check",
		"lint:types": "tsc --noEmit"
	},
	"dependencies": {
		"@noble/ciphers": "^2.3.0",
		"@noble/curves": "^2.3.0",
		"@noble/hashes": "^2.3.0",
		"@revenge-mod/devtools-client": "^1.4.0",
		"@revenge-mod/devtools-shared": "^1.3.0",
		"@revenge-mod/plugin-cli": "git+https://github.com/revenge-mod/revenge-plugin-cli.git",
		"@revenge-mod/types": "git+https://github.com/revenge-mod/revenge-types.git",
		"@scure/base": "^2.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@shopify/flash-list": "^2.3.2",
		"@types/node": "^26.1.2",
		"@types/react": "^19.2.17",
		"react-native": "0.86.0",
		"tsx": "^4.20.6",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"@react-native/community-cli-plugin": "npm:dry-uninstall",
		"@react-native/codegen": "npm:dry-uninstall",
		"babel-jest": "npm:dry-uninstall",
		"babel-plugin-syntax-hermes-parser": "npm:dry-uninstall",
		"hermes-compiler": "npm:dry-uninstall",
		"jsc-android": "npm:dry-uninstall",
		"react-devtools-core": "npm:dry-uninstall",
		"recyclerlistview": "npm:dry-uninstall",
		"react-native-gesture-handler": "npm:dry-uninstall",
		"react-native-screens": "npm:dry-uninstall"
	},
	"trustedDependencies": [
		"@swc/core"
	]
}
